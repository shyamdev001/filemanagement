# Copy this file to ".env" and fill in the values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Put the database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/solar_files?retryWrites=true&w=majority

# Folder with the panel / inverter datasheet PDFs. Leave empty to use the "datasheets" folder in the project.
DATASHEET_DIR=

# Where uploaded PDFs (DCR / Agreement / FL) are kept. Leave empty to keep them on this PC in the "data" folder.
# For hosting, fill in the three values from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sign-in: every staff member has their own account (made in the app, Staff page). No password goes here.

PORT=4000
